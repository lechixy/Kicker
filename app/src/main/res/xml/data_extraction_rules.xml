<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="file" path="datastore/kick_settings.preferences_pb" />
        <exclude domain="sharedpref" path="recording_download_queue.xml" />
        <exclude domain="sharedpref" path="playback_usage.xml" />
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="file" path="datastore/kick_settings.preferences_pb" />
        <exclude domain="sharedpref" path="recording_download_queue.xml" />
        <exclude domain="sharedpref" path="playback_usage.xml" />
    </device-transfer>
</data-extraction-rules>
